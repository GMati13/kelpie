{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    24,
    15
  ],
  "theme": "kelpie",
  "ui_font": "Geist",
  "background": "#1a1714",
  "terminal_padding": [
    14,
    16
  ],
  "terminal_opacity": 0,
  "padding": 0,
  "gap": 0,
  "preview": "layouts/kelpie.svg",
  "divider": {
    "width": 1,
    "color": "#ffffff14"
  },
  "children": [
    {
      "id": "side",
      "type": "column",
      "size": {
        "px": 290
      },
      "min": 220,
      "max": 440,
      "resizable": false,
      "background": "#161310",
      "children": [
        {
          "id": "side-top",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "kelpie",
            "props": {
              "role": "space-picker"
            }
          }
        },
        {
          "id": "side-list",
          "type": "block",
          "content": {
            "mod": "kelpie",
            "props": {
              "role": "work-side"
            }
          }
        },
        {
          "id": "side-foot",
          "type": "block",
          "size": {
            "px": 70
          },
          "content": {
            "mod": "kelpie",
            "props": {
              "role": "footer"
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "divider": {
        "width": 1,
        "color": "#ffffff14"
      },
      "children": [
        {
          "id": "story-head",
          "type": "block",
          "size": {
            "px": 50
          },
          "min": 50,
          "max": 50,
          "content": {
            "mod": "kelpie",
            "props": {
              "role": "stories"
            }
          }
        },
        {
          "id": "details",
          "type": "column",
          "resizable": true,
          "children": [
            {
              "id": "story-body",
              "type": "block",
              "hidden": true,
              "size": {
                "weight": 1
              },
              "min": 60,
              "content": {
                "mod": "kelpie",
                "props": {
                  "role": "story-body"
                }
              }
            },
            {
              "id": "lower",
              "type": "column",
              "size": {
                "weight": 3
              },
              "min": 160,
              "resizable": false,
              "divider": {
                "width": 1,
                "color": "#ffffff14"
              },
              "children": [
                {
                  "id": "toolbar",
                  "type": "block",
                  "size": {
                    "px": 42
                  },
                  "padding": [
                    0,
                    4
                  ],
                  "window_drag": true,
                  "content": {
                    "mod": "kelpie",
                    "props": {
                      "role": "toolbar"
                    }
                  },
                  "min": 42,
                  "max": 42
                },
                {
                  "id": "main-stack",
                  "type": "stack",
                  "active": "main",
                  "children": [
                    {
                      "id": "main",
                      "type": "block",
                      "content": {
                        "tab": "active",
                        "pane": {
                          "gap": 0,
                          "radius": 0,
                          "background": "#1a1714",
                          "lone": false,
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "focus": {
                            "width": 0,
                            "color": "#00000000"
                          },
                          "header": {
                            "content": {
                              "mod": "kelpie",
                              "props": {
                                "role": "pane-head"
                              }
                            },
                            "height": 32,
                            "position": "top",
                            "reveal": "always"
                          }
                        }
                      },
                      "padding": 0
                    },
                    {
                      "id": "story-view",
                      "type": "block",
                      "background": "#1a1714",
                      "content": {
                        "mod": "kelpie",
                        "props": {
                          "role": "story-view"
                        }
                      }
                    },
                    {
                      "id": "story-shots",
                      "type": "block",
                      "background": "#1a1714",
                      "content": {
                        "mod": "kelpie-artifacts",
                        "props": {
                          "scope": "story"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "divider": {
            "width": 1,
            "color": "#ffffff14"
          }
        },
        {
          "id": "toolbar-start",
          "type": "block",
          "size": {
            "px": 42
          },
          "padding": [
            0,
            4
          ],
          "window_drag": true,
          "content": {
            "mod": "kelpie",
            "props": {
              "role": "toolbar",
              "slot": "start"
            }
          },
          "min": 42,
          "max": 42,
          "hidden": true
        }
      ],
      "resizable": false
    },
    {
      "id": "panel",
      "type": "column",
      "hidden": true,
      "size": {
        "px": 360
      },
      "min": 280,
      "max": 2400,
      "background": "#161310",
      "children": [
        {
          "id": "panel-body",
          "type": "stack",
          "active": "files",
          "children": [
            {
              "id": "files",
              "type": "block",
              "content": {
                "mod": "files"
              }
            },
            {
              "id": "changes",
              "type": "block",
              "content": {
                "mod": "changes"
              }
            },
            {
              "id": "artifacts",
              "type": "block",
              "content": {
                "mod": "kelpie-artifacts"
              }
            },
            {
              "id": "web",
              "type": "block",
              "radius": 12,
              "content": {
                "terminal": "web"
              }
            },
            {
              "id": "web-1",
              "type": "block",
              "radius": 12,
              "content": {
                "terminal": "web-1"
              }
            },
            {
              "id": "web-2",
              "type": "block",
              "radius": 12,
              "content": {
                "terminal": "web-2"
              }
            }
          ]
        }
      ],
      "resizable": false
    }
  ]
}
