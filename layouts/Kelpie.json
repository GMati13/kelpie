            {
              "id": "changes",
              "type": "block",
              "content": {
                "mod": "changes"
              }
            },
            {
              "id": "artifacts",
              "type": "block",
              "content": {
                "mod": "kelpie-artifacts"
              }
            },
            {
              "id": "web",
              "type": "block",
              "content": {
                "terminal": "web"
              },
              "radius": 12
            }
          ],
          "active": "files"
        }
