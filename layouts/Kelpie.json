                    {
                      "id": "story-view",
                      "type": "block",
                      "content": {
                        "mod": "kelpie",
                        "props": {
                          "role": "story-view"
                        }
                      },
                      "background": "#1e1c1a"
                    },
                    {
                      "id": "story-shots",
                      "type": "block",
                      "content": {
                        "mod": "kelpie-artifacts",
                        "props": {
                          "scope": "story"
                        }
                      },
                      "background": "#1e1c1a"
                    }
                  ],
                  "active": "main"
                }
              ],
              "size": {
                "weight": 3
              },
